# --- Datos ---
# Datos crudos: exportación completa del chat (no se versiona)
data/raw/

# Datos intermedios y procesados: contienen mensajes textuales y la tabla de
# equivalencias de nombres. Se ignora el contenido pero se conserva .gitkeep
# para que las carpetas aparezcan en GitHub.
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/
venv/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Editor / sistema operativo ---
.vscode/
.DS_Store
Thumbs.db
desktop.ini
